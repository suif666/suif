-- =================== NPC/玩家 范围显示模块（含调试） ===================
print("[调试] 脚本开始加载...")

local RangeModule = {
    Settings = {
        Target = "NPC",
        Mode = "Box",
        ShowHealth = false,
        BoxSize = 6,
        BoxColor = Color3.fromRGB(0, 255, 0)
    },
    Active = false,
    Stored = {},
    Boxes = {},
    Connections = {},
}

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local LocalPlayer = Players.LocalPlayer
local Workspace = game:GetService("Workspace")

print("[调试] 服务已获取")

-- ===== 辅助函数 =====
local function GetTargetParts(obj)
    local parts = {}
    if obj:FindFirstChild("HumanoidRootPart") then
        table.insert(parts, obj.HumanoidRootPart)
    end
    if obj:FindFirstChild("Head") then
        table.insert(parts, obj.Head)
    end
    for _, name in ipairs({"UpperTorso", "LowerTorso", "Torso"}) do
        if obj:FindFirstChild(name) then
            table.insert(parts, obj[name])
        end
    end
    return parts
end

local function IsNPC(obj)
    if not obj or not obj:IsA("Model") then return false end
    if Players:GetPlayerFromCharacter(obj) then return false end
    return obj:FindFirstChildOfClass("Humanoid") ~= nil
end

local function IsPlayer(obj)
    if not obj or not obj:IsA("Model") then return false end
    local plr = Players:GetPlayerFromCharacter(obj)
    return plr and plr ~= LocalPlayer
end

print("[调试] 辅助函数已定义")

-- ===== 正常放大 =====
local function EnlargeBySize(obj, multiplier)
    if not obj then return end
    local parts = GetTargetParts(obj)
    for _, p in ipairs(parts) do
        if not RangeModule.Stored[p] then
            RangeModule.Stored[p] = {
                Size = p.Size,
                Transparency = p.Transparency,
                CanCollide = p.CanCollide
            }
        end
        p.Size = RangeModule.Stored[p].Size * multiplier
        p.Transparency = 0.25
        p.CanCollide = false
    end
end

local function RestoreSize(obj)
    if not obj then return end
    local parts = GetTargetParts(obj)
    for _, p in ipairs(parts) do
        if RangeModule.Stored[p] then
            p.Size = RangeModule.Stored[p].Size
            p.Transparency = RangeModule.Stored[p].Transparency
            p.CanCollide = RangeModule.Stored[p].CanCollide
            RangeModule.Stored[p] = nil
        end
    end
end

print("[调试] 放大函数已定义")

-- ===== 透明框 =====
local function CreateBox(obj, color, size)
    if not obj then return end
    local root = obj:FindFirstChild("HumanoidRootPart") or obj.PrimaryPart
    if not root then return end

    local existing = RangeModule.Boxes[obj]
    if existing and existing.Parent then
        return existing
    end

    local box = Instance.new("SelectionBox")
    box.Adornee = root
    box.Color3 = color or RangeModule.Settings.BoxColor
    box.Transparency = 0.7
    box.LineThickness = 0.08
    box.Size = Vector3.new(size or 6, size or 6, size or 6)
    box.Parent = root
    RangeModule.Boxes[obj] = box

    local conn
    conn = obj.AncestryChanged:Connect(function()
        if not obj.Parent then
            pcall(function() box:Destroy() end)
            RangeModule.Boxes[obj] = nil
            if conn then conn:Disconnect() end
        end
    end)
    table.insert(RangeModule.Connections, conn)
    return box
end

local function RemoveBox(obj)
    if RangeModule.Boxes[obj] then
        pcall(function() RangeModule.Boxes[obj]:Destroy() end)
        RangeModule.Boxes[obj] = nil
    end
end

print("[调试] 透明框函数已定义")

-- ===== 应用/移除 =====
local function ApplyToTarget(obj, multiplier, mode, color, size)
    if not obj then return end
    if mode == "Size" then
        EnlargeBySize(obj, multiplier)
    elseif mode == "Box" then
        CreateBox(obj, color, size)
    end
end

local function RemoveFromTarget(obj)
    if not obj then return end
    RestoreSize(obj)
    RemoveBox(obj)
end

local function ApplyAll()
    local target = RangeModule.Settings.Target
    local mode = RangeModule.Settings.Mode
    local mult = 4
    local color = RangeModule.Settings.BoxColor
    local size = RangeModule.Settings.BoxSize

    -- 清除旧的
    for obj in pairs(RangeModule.Boxes) do
        RemoveFromTarget(obj)
    end
    for part, _ in pairs(RangeModule.Stored) do
        if part and part.Parent then
            local model = part.Parent
            if model and (IsNPC(model) or IsPlayer(model)) then
                RestoreSize(model)
            end
        end
    end
    RangeModule.Stored = {}
    RangeModule.Boxes = {}

    local allTargets = {}
    if target == "NPC" or target == "Both" then
        for _, obj in ipairs(Workspace:GetDescendants()) do
            if IsNPC(obj) then
                table.insert(allTargets, obj)
            end
        end
    end
    if target == "Player" or target == "Both" then
        for _, obj in ipairs(Workspace:GetDescendants()) do
            if IsPlayer(obj) then
                table.insert(allTargets, obj)
            end
        end
    end

    for _, obj in ipairs(allTargets) do
        ApplyToTarget(obj, mult, mode, color, size)
    end
end

local function SetupListener()
    local conn = Workspace.DescendantAdded:Connect(function(obj)
        if not RangeModule.Active then return end
        task.delay(0.2, function()
            if not RangeModule.Active then return end
            local target = RangeModule.Settings.Target
            local mode = RangeModule.Settings.Mode
            local mult = 4
            local color = RangeModule.Settings.BoxColor
            local size = RangeModule.Settings.BoxSize

            if obj:IsA("Model") then
                local apply = false
                if target == "NPC" or target == "Both" then
                    if IsNPC(obj) then apply = true end
                end
                if target == "Player" or target == "Both" then
                    if IsPlayer(obj) then apply = true end
                end
                if apply then
                    ApplyToTarget(obj, mult, mode, color, size)
                end
            end
        end)
    end)
    table.insert(RangeModule.Connections, conn)
end

print("[调试] 应用/监听函数已定义")

-- ===== 启用/禁用 =====
function RangeModule:Enable()
    if self.Active then return end
    self.Active = true
    ApplyAll()
    SetupListener()
    print("[范围模块] 已启用")
end

function RangeModule:Disable()
    self.Active = false
    for part, _ in pairs(self.Stored) do
        if part and part.Parent then
            local model = part.Parent
            RestoreSize(model)
        end
    end
    for obj, box in pairs(self.Boxes) do
        RemoveBox(obj)
    end
    self.Stored = {}
    self.Boxes = {}
    for _, conn in ipairs(self.Connections) do
        pcall(function() conn:Disconnect() end)
    end
    self.Connections = {}
    print("[范围模块] 已禁用")
end

print("[调试] 启用/禁用函数已定义")

-- ===== UI 绑定（含调试） =====
local function CreateUI(tab)
    print("[调试] 开始绑定 UI...")

    -- 调试：打印 tab 的所有方法
    print("[调试] tab 对象的方法列表:")
    if type(tab) == "table" then
        for k, v in pairs(tab) do
            if type(v) == "function" then
                print("  ✅ " .. k)
            end
        end
    else
        print("  ❌ tab 不是一个表，类型为: " .. type(tab))
    end

    -- 检查关键方法是否存在
    local methods = {"Toggle", "Slider", "Dropdown", "Input", "Button", "Paragraph"}
    for _, m in ipairs(methods) do
        if tab[m] then
            print("[调试] 方法 " .. m .. " 存在")
        else
            warn("[调试] 方法 " .. m .. " 不存在，这可能导致错误！")
        end
    end

    -- 开始创建控件（所有调用均用 pcall 保护）
    local function safeCall(func)
        local success, err = pcall(func)
        if not success then
            warn("[UI错误] " .. tostring(err))
        end
        return success
    end

    safeCall(function()
        tab:Toggle({
            Title = "启用范围显示",
            Default = false,
            Callback = function(v)
                if v then RangeModule:Enable() else RangeModule:Disable() end
            end
        })
        print("[调试] Toggle '启用范围显示' 创建成功")
    end)

    -- 目标选择：用三个 Toggle
    local targetState = {NPC = true, Player = false, Both = false}
    local function updateTarget()
        local t = "NPC"
        if targetState.Player then t = "Player"
        elseif targetState.Both then t = "Both" end
        RangeModule.Settings.Target = t
        if RangeModule.Active then
            RangeModule:Disable()
            RangeModule:Enable()
        end
    end

    safeCall(function()
        tab:Toggle({
            Title = "目标: NPC",
            Default = true,
            Callback = function(v)
                targetState.NPC = v
                if v then targetState.Player = false; targetState.Both = false end
                updateTarget()
            end
        })
        print("[调试] Toggle '目标: NPC' 创建成功")
    end)

    safeCall(function()
        tab:Toggle({
            Title = "目标: 玩家",
            Default = false,
            Callback = function(v)
                targetState.Player = v
                if v then targetState.NPC = false; targetState.Both = false end
                updateTarget()
            end
        })
        print("[调试] Toggle '目标: 玩家' 创建成功")
    end)

    safeCall(function()
        tab:Toggle({
            Title = "目标: 两者",
            Default = false,
            Callback = function(v)
                targetState.Both = v
                if v then targetState.NPC = false; targetState.Player = false end
                updateTarget()
            end
        })
        print("[调试] Toggle '目标: 两者' 创建成功")
    end)

    -- 放大方式
    local modeState = {Box = true, Size = false}
    safeCall(function()
        tab:Toggle({
            Title = "方式: 透明框",
            Default = true,
            Callback = function(v)
                modeState.Box = v
                if v then modeState.Size = false end
                RangeModule.Settings.Mode = v and "Box" or "Size"
                if RangeModule.Active then
                    RangeModule:Disable()
                    RangeModule:Enable()
                end
            end
        })
        print("[调试] Toggle '方式: 透明框' 创建成功")
    end)

    safeCall(function()
        tab:Toggle({
            Title = "方式: 正常放大",
            Default = false,
            Callback = function(v)
                modeState.Size = v
                if v then modeState.Box = false end
                RangeModule.Settings.Mode = v and "Size" or "Box"
                if RangeModule.Active then
                    RangeModule:Disable()
                    RangeModule:Enable()
                end
            end
        })
        print("[调试] Toggle '方式: 正常放大' 创建成功")
    end)

    -- 颜色切换按钮
    local colors = {"绿色", "红色", "蓝色", "黄色", "紫色"}
    local colorIndex = 1
    safeCall(function()
        tab:Button({
            Title = "当前颜色: 绿色 (点击切换)",
            Callback = function()
                colorIndex = colorIndex % #colors + 1
                local name = colors[colorIndex]
                local map = {
                    ["绿色"] = Color3.fromRGB(0, 255, 0),
                    ["红色"] = Color3.fromRGB(255, 0, 0),
                    ["蓝色"] = Color3.fromRGB(0, 0, 255),
                    ["黄色"] = Color3.fromRGB(255, 255, 0),
                    ["紫色"] = Color3.fromRGB(200, 0, 255)
                }
                RangeModule.Settings.BoxColor = map[name]
                if RangeModule.Active and RangeModule.Settings.Mode == "Box" then
                    RangeModule:Disable()
                    RangeModule:Enable()
                end
                -- 更新按钮文字（WindUI 可能不支持直接修改，这里不处理）
            end
        })
        print("[调试] Button '当前颜色' 创建成功")
    end)

    -- 滑块
    safeCall(function()
        tab:Slider({
            Title = "透明框大小",
            Value = {
                Min = 2,
                Max = 12,
                Default = RangeModule.Settings.BoxSize
            },
            Callback = function(v)
                RangeModule.Settings.BoxSize = v
                if RangeModule.Active and RangeModule.Settings.Mode == "Box" then
                    RangeModule:Disable()
                    RangeModule:Enable()
                end
            end
        })
        print("[调试] Slider '透明框大小' 创建成功")
    end)

    -- NPC 血量显示（默认关闭）
    safeCall(function()
        tab:Toggle({
            Title = "NPC 血量显示",
            Default = false,
            Callback = function(v)
                RangeModule.Settings.ShowHealth = v
                print("血量显示设置为:", v)
            end
        })
        print("[调试] Toggle 'NPC 血量显示' 创建成功")
    end)

    print("[调试] UI 绑定完成")
end

