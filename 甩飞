-- 玩家列表（用于多选）
local selectedPlayers = {}
local playerDropdown = nil

local function RefreshPlayerList()
    local names = {}
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer then
            table.insert(names, p.Name)
        end
    end
    table.insert(names, 1, "所有人")
    return names
end

-- 多选下拉框（选择目标）
playerDropdown = tab:Dropdown({
    Title = "选择甩飞目标（可多选）",
    Multi = true,
    Values = RefreshPlayerList(),
    Value = {},
    Callback = function(selected)
        selectedPlayers = {}
        local hasAll = false
        for _, name in ipairs(selected) do
            if name == "所有人" then
                hasAll = true
                break
            end
        end
        if hasAll then
            selectedPlayers = { "ALL" }
        else
            for _, name in ipairs(selected) do
                local plr = Players:FindFirstChild(name)
                if plr then
                    table.insert(selectedPlayers, plr)
                end
            end
        end
    end
})

-- 刷新按钮
tab:Button({
    Title = "刷新玩家列表",
    Callback = function()
        local names = RefreshPlayerList()
        playerDropdown:Refresh(names, {})
    end
})

-- 甩飞一次
tab:Button({
    Title = "甩飞一次",
    Callback = function()
        if #selectedPlayers == 0 then
            Notify("提示", "请先选择目标", 2)
            return
        end
        for _, target in ipairs(selectedPlayers) do
            FlingOnce(target)
        end
    end
})

-- 循环甩飞开关
local loopToggle = tab:Toggle({
    Title = "循环甩飞（轮流）",
    Default = false,
    Callback = function(v)
        if v then
            if #selectedPlayers == 0 then
                Notify("提示", "请先选择目标", 2)
                loopToggle:Set(false)
                return
            end
            StartFlingLoop(selectedPlayers)
        else
            StopFlingLoop()
        end
    end
})

-- 停止按钮
tab:Button({
    Title = "停止循环甩飞",
    Callback = function()
        StopFlingLoop()
        if loopToggle.Set then
            loopToggle:Set(false)
        end
    end
})

