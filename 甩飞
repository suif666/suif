-- ===== 右侧悬浮按钮（类似截图的「夜脚本」） =====
local function CreateSideButton()
    local gui = Instance.new("ScreenGui")
    gui.Name = "FlingSideButton"
    gui.ResetOnSpawn = false
    gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
    pcall(function() gui.Parent = CoreGui end)
    if not gui.Parent then gui.Parent = LocalPlayer:WaitForChild("PlayerGui") end

    local btn = Instance.new("TextButton")
    btn.Name = "ToggleBtn"
    btn.Size = UDim2.new(0, 36, 0, 90)
    btn.Position = UDim2.new(1, -46, 0.4, 0)
    btn.BackgroundColor3 = Color3.fromRGB(30, 30, 35)
    btn.BorderSizePixel = 0
    btn.Text = "甩\n飞"
    btn.TextColor3 = Color3.fromRGB(255, 255, 255)
    btn.TextSize = 14
    btn.Font = Enum.Font.GothamBold
    btn.Parent = gui

    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 8)
    corner.Parent = btn

    local stroke = Instance.new("UIStroke")
    stroke.Color = Color3.fromRGB(0, 200, 255)
    stroke.Thickness = 1.5
    stroke.Parent = btn

    local visible = true
    btn.MouseButton1Click:Connect(function()
        visible = not visible
        pcall(function()
            Window:SetVisible(visible)  -- 部分 WindUI 支持
        end)
        -- 兜底：直接控制窗口 GUI
        for _, g in ipairs(CoreGui:GetChildren()) do
            if g.Name:find("WindUI") or g.Name:find("Range") or g.Name:find("Fling") then
                -- 根据实际窗口名调整
            end
        end
        -- 最稳妥的方式：很多 WindUI 窗口可以通过 Toggle 方法
        pcall(function()
            if Window.Toggle then
                Window:Toggle()
            elseif Window.Visible ~= nil then
                Window.Visible = visible
            end
        end)
    end)

    -- 可拖动
    local dragging, dragStart, startPos
    btn.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            dragStart = input.Position
            startPos = btn.Position
        end
    end)
    btn.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = false
        end
    end)
    UserInputService.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            local delta = input.Position - dragStart
            btn.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
        end
    end)
end

CreateSideButton()

